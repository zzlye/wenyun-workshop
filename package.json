{
  "name": "wenyun-workshop",
  "private": true,
  "version": "0.4.14",
  "type": "module",
  "scripts": {
    "predev": "node scripts/package-canvas-agent.mjs",
    "prebuild": "node scripts/package-canvas-agent.mjs",
    "agent:package": "node scripts/package-canvas-agent.mjs",
    "dev": "vite",
    "tasks": "node server/image-tasks.mjs",
    "agent:install": "npm --prefix canvas-agent ci",
    "agent": "npm --prefix canvas-agent run dev",
    "agent:build": "npm --prefix canvas-agent run build",
    "agent:test": "node --test canvas-agent/launcher.node-test.mjs && npm --prefix canvas-agent test",
    "desktop": "node desktop/scripts/run.mjs",
    "desktop:build": "node desktop/scripts/build.mjs",
    "desktop:test": "node --test desktop/test/*.test.cjs",
    "desktop:smoke": "node desktop/test/smoke.mjs",
    "desktop:update-smoke": "node desktop/test/update-feed-smoke.mjs",
    "mock:api": "node scripts/mock-image-api.mjs",
    "build": "tsc -b && vite build",
    "deploy:cf": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "test": "vitest run --exclude canvas-agent/** --exclude desktop/**",
    "test:watch": "vitest --exclude canvas-agent/** --exclude desktop/**",
    "bench:canvas": "vitest bench --run",
    "test:tasks": "node --test server/*.node-test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@ant-design/pro-components": "^3.0.0-beta.3",
    "@codemirror/lang-json": "^6.0.2",
    "@fal-ai/client": "^1.10.0",
    "@tanstack/react-query": "^5.100.14",
    "@types/file-saver": "^2.0.7",
    "@uiw/react-codemirror": "^4.25.10",
    "antd": "^6.4.3",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "core-js": "^3.49.0",
    "dayjs": "^1.11.21",
    "fflate": "^0.8.2",
    "file-saver": "^2.0.5",
    "i18next": "^26.4.4",
    "localforage": "^1.10.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.11",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.16",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.5"
  },
  "overrides": {
    "mdast-util-gfm-autolink-literal": "2.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "happy-dom": "20.11.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.88.0"
  }
}
