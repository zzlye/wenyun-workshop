{
    servers :443 {
        protocols h1 h2
    }
}

zzlye.xyz, xn--v5z30ywuk.com {

    encode zstd gzip

    # 桌面更新独立于网页镜像，重建网站不会删除安装包；缺失文件不能回退成网页。
    handle_path /desktop-updates/* {
        root * /data/wenyun-desktop-updates
        @manifest path /latest.yml
        header @manifest Cache-Control "no-store"
        header X-Content-Type-Options "nosniff"
        file_server
    }

    handle {
        reverse_proxy 127.0.0.1:8080
    }
}

api.zzlye.xyz, api.zzlye.site {

    reverse_proxy 127.0.0.1:3001
}

ak.zzlye.site {

    encode zstd gzip

    reverse_proxy 127.0.0.1:8080
}

# 裸 IP 仅提供 HTTP 访问，避免跳转到无证书的 HTTPS 地址。
http://38.244.15.80 {
    reverse_proxy 127.0.0.1:8080
}

# 保留原有直连端口，统一转发到新版实例。
http://:3000 {
    reverse_proxy 127.0.0.1:3001 {
        # 仅信任西米露容器，保留外层代理已校验的来源，避免客户共用限流额度。
        # 由 sync-wenyun-proxy-trust.py 跟随容器地址更新，始终仅信任一个地址。
        trusted_proxies 172.19.0.3/32
    }
}
